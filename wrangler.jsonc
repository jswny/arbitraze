/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arbitraze",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-03",
	"migrations": [
		{
			"new_sqlite_classes": ["KalshiWebsocketDurableObject"],
			"tag": "v1",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "KalshiWebsocketDurableObject",
				"name": "KALSHI_WEBSOCKET_DO",
			},
		],
	},
	"queues": {
		"producers": [
			{
				"binding": "KALSHI_SNAPSHOTS_QUEUE",
				"queue": "kalshi-snapshots",
			},
			{
				"binding": "POLYMARKET_SNAPSHOTS_QUEUE",
				"queue": "polymarket-snapshots",
			},
		],
		"consumers": [
			{
				"queue": "kalshi-snapshots",
				"max_batch_size": 40,
				"max_batch_timeout": 5,
			},
			{
				"queue": "polymarket-snapshots",
				"max_batch_size": 40,
				"max_batch_timeout": 5,
			},
		],
	},
	"vectorize": [
		{
			"binding": "MARKET_METADATA_VECTORS",
			"index_name": "arbitraze-matching-markets-dev",
			"remote": true,
		},
	],
	"ai": {
		"binding": "AI",
		"remote": true,
	},
	"d1_databases": [
		{
			"binding": "MARKET_METADATA_DB",
			"database_name": "arbitraze-market-metadata",
			"database_id": "arbitraze-market-metadata",
			"migrations_dir": "migrations",
		},
	],
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	"observability": {
		"enabled": true,
	},
}
